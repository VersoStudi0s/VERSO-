# Variáveis públicas (vão para o navegador). Nunca coloque segredos aqui.
# Configure também em Cloudflare Pages → Settings → Environment variables.

# URL pública do site. Usada em canonical, Open Graph e sitemap.
VITE_SITE_URL=https://verso-e5t.pages.dev

# WhatsApp comercial: só dígitos, com país e DDD (ex.: 5511999999999).
# Sem ele, os botões de conversa levam ao direct do Instagram.
VITE_WHATSAPP_NUMBER=

# Opcional: substitui o e-mail padrão de src/config/site.ts.
VITE_CONTACT_EMAIL=

# Analytics (só carregam após consentimento). Deixe vazio para desativar.
# Hash do Metricool. Padrão: o da conta @versostudioss. Use "off" para desativar.
VITE_METRICOOL_HASH=
VITE_PLAUSIBLE_DOMAIN=
VITE_GA_ID=
