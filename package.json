    "test:github": "node scripts/test-github-service.mjs && node scripts/test-github-browser.mjs"
  },
  "dependencies": {
    "@fontsource/barlow-condensed": "^5.2.8",
    "@fontsource/cormorant-garamond": "^5.2.8",
    "@fontsource/ibm-plex-mono": "^5.2.7",
    "@phosphor-icons/vue": "^2.2.1",
    "@vue/server-renderer": "^3.5.44",
    "vue": "^3.5.22",
    "vue-router": "^4.6.3"
  },
  "devDependencies": {
    "@axe-core/playwright": "^4.10.2",
    "@playwright/test": "^1.56.0",
    "@types/node": "^24.9.1",
    "@vitejs/plugin-vue": "^6.0.1",
    "lighthouse": "^13.0.1",
    "typescript": "~5.9.3",
    "vite": "^7.1.12",
    "vue-tsc": "^3.1.1"
  }
